{
  "bugs": {
    "url": "https://github.com/API-Disk-Integrations/agent-mandate/issues"
  },
  "description": "Convert user intent into signed mandates and verify consequential agent actions against mandate, policy and approvals.",
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://agentmandate-api.com/",
  "keywords": [
    "api",
    "sdk",
    "agent-mandate"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "name": "agent-mandate",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/API-Disk-Integrations/agent-mandate.git"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node test/smoke.mjs"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.0"
}
